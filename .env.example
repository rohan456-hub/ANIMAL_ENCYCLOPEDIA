# Backend services (set these in Render/Railway; do not commit a real .env file)
NODE_ENV=development
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret

# Comma-separated frontend origins. Include local CRA ports during development.
CLIENT_URLS=http://localhost:3000,http://localhost:3001

# Required by adminserver only. Use the email address(es) permitted to access the admin API.
ADMIN_EMAILS=admin@example.com

# Local development only. Cloud platforms set PORT automatically.
PORT=4000
